# Meshtastic Configuration
# Serial port for the Meshtastic device (e.g., /dev/ttyUSB0, /dev/ttyACM0 on Linux, COM3 on Windows)
# If commented out or not set, the Meshtastic library will attempt to auto-detect the port.
# MESHTASTIC_SERIAL_PORT=/dev/ttyUSB0

# Relay Board Configuration (Optional - automatic device power-cycle recovery)
# Serial port for the DIY relay board (see hardware/power_relay_firmware/). Always explicit,
# never auto-detected. If unset, a wedged device is still detected and logged, just not power-cycled.
# RELAY_SERIAL_PORT=/dev/ttyUSB1
# RELAY_SERIAL_BAUD=115200   # baud rate, matches the firmware default
# RELAY_CHANNEL=1            # which relay channel controls this machine's device (default 1)

# Bitcoin RPC Configuration (required to broadcast transactions)
# BITCOIN_RPC_HOST=127.0.0.1
# Use a .onion address here instead to connect via Tor (requires Tor running locally on port 9050) - see README's Tor Setup section.
# BITCOIN_RPC_PORT=8332 # 8332 mainnet, 18332 testnet3, 48332 testnet4, 38332 signet, 18443 regtest

## Just choose ONE! what you use. BITCOIN_RPC_COOKIE if use rpcauth on bitcoin.conf.
# BITCOIN_RPC_COOKIE=/data/bitcoin/.cookie   # set your bitcoin .cookie file directory (testnet4 directory: /data/bitcoin/testnet4/.cookie )
## OR choose
# BITCOIN_RPC_USER=your_rpc_user
# BITCOIN_RPC_PASSWORD=your_rpc_password

# Server Configuration
# How long (seconds) the server waits for all chunks of a transaction before discarding an incomplete session. Default 30 if unset.
# REASSEMBLY_TIMEOUT_SECONDS=30

# Logging Configuration
# Controls both console and file log verbosity for the CLI entry points
# (btcmesh_server_cli.py / btcmesh_client_cli.py). Not used by either GUI -
# they show their own in-app activity log independent of this setting.
# Accepted values: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
# Defaults to INFO if unset or invalid.
# LOG_LEVEL=INFO
